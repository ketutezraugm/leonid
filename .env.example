# API server
PORT=3001
# Supabase Postgres. Use the transaction pooler URL (Project Settings > Database > Connection
# string > Transaction pooler); the API connects server-side only. Then: pnpm --filter @quartermaster/api db:migrate && db:seed
DATABASE_URL=

# PayPal sandbox: Treasury app (Identity, Invoicing, income Orders, Payouts, Transaction Search)
PAYPAL_TREASURY_CLIENT_ID=
PAYPAL_TREASURY_CLIENT_SECRET=

# PayPal sandbox: Procurement app (Vault, spend Orders, tracking, refunds, disputes)
PAYPAL_PROCUREMENT_CLIENT_ID=
PAYPAL_PROCUREMENT_CLIENT_SECRET=

# One webhook per PayPal app, shown on the webhook after you save it in the developer dashboard
PAYPAL_TREASURY_WEBHOOK_ID=
PAYPAL_PROCUREMENT_WEBHOOK_ID=
# The treasurer's PayPal payer id (13 characters; sandbox: account details of the treasurer's sandbox account).
# The CHECKOUT.ORDER.APPROVED webhook captures a spend only if this account approved it; unset, it captures nothing.
TREASURY_PAYPAL_PAYER_ID=
# Set to false ONLY locally (replayed fixture events); the server refuses to start with false in production
PAYPAL_WEBHOOK_VERIFY=true
# Accept PayPal's webhook simulator, which signs with the literal id WEBHOOK_ID (staging and demo only)
PAYPAL_ACCEPT_SIMULATOR_EVENTS=false

# Day-1 tests (P3, PRD §14). Sandbox accounts only; see docs/p3/stage-0.md.
# Sandbox PERSONAL account that pays the test invoice
DAY1_SPONSOR_EMAIL=
# Sandbox account that receives the PayPal payout item
DAY1_PAYPAL_RECIPIENT_EMAIL=
# Venmo test recipient: a handle, or an email tied to a Venmo sandbox account. Leave both blank to skip Venmo.
DAY1_VENMO_HANDLE=
DAY1_VENMO_EMAIL=

# Public base URL of this deployment; PayPal sends the treasurer back to it after connecting the wallet
APP_BASE_URL=http://localhost:5173
# Interim treasurer guard (header x-treasurer-token) for the wallet and kill-switch routes, until Log in with PayPal sessions exist
TREASURER_TOKEN=

CHANNEL3_API_KEY=

# LLM via OpenRouter (OpenAI-compatible API). Swap the model here, not in code.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Web research for the venue scout (Tavily). Optional: without it the agent has no search tools.
TAVILY_API_KEY=

# AG Studio licence key for the Money command center (P3). Do not commit a real key until the sponsor
# confirms on Discord that a public key is fine.
VITE_AG_STUDIO_LICENSE=
