# API server
PORT=3001
DATABASE_URL=postgres://localhost:5432/quartermaster

# PayPal sandbox: Treasury app (Identity, Invoicing, income Orders, Payouts, Transaction Search)
PAYPAL_TREASURY_CLIENT_ID=
PAYPAL_TREASURY_CLIENT_SECRET=

# PayPal sandbox: Procurement app (Vault, spend Orders, tracking, refunds, disputes)
PAYPAL_PROCUREMENT_CLIENT_ID=
PAYPAL_PROCUREMENT_CLIENT_SECRET=

# One webhook per PayPal app, shown on the webhook after you save it in the developer dashboard
PAYPAL_TREASURY_WEBHOOK_ID=
PAYPAL_PROCUREMENT_WEBHOOK_ID=
# Set to false ONLY locally (replayed fixture events); the server refuses to start with false in production
PAYPAL_WEBHOOK_VERIFY=true
# Accept PayPal's webhook simulator, which signs with the literal id WEBHOOK_ID (staging and demo only)
PAYPAL_ACCEPT_SIMULATOR_EVENTS=false

CHANNEL3_API_KEY=
LLM_API_KEY=
