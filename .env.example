# API server
PORT=3001
# Public base URL of this deployment (PayPal login return URL and webhook URLs are built from it)
APP_BASE_URL=http://localhost:5173
# Local dev: Docker Postgres (pnpm db:up). Staging/prod: the Supabase pooler connection string, set in the Render dashboard
DATABASE_URL=postgres://quartermaster:quartermaster@localhost:5432/quartermaster
# Long random string, signs the session cookie
SESSION_SECRET=
# Shared secret that Render Workflows send to /api/internal/jobs/*
INTERNAL_JOBS_SECRET=

# Demo mode: enables the rate-limited "Enter demo as treasurer" button
DEMO_MODE=true
# Set to false ONLY locally (replayed fixture webhooks); the server refuses to start with false in production
PAYPAL_WEBHOOK_VERIFY=true

# PayPal sandbox: Treasury app (Identity, Invoicing, income Orders, Payouts, Transaction Search)
PAYPAL_TREASURY_CLIENT_ID=
PAYPAL_TREASURY_CLIENT_SECRET=
PAYPAL_TREASURY_WEBHOOK_ID=

# PayPal sandbox: Procurement app (Vault, spend Orders, tracking, refunds, disputes)
PAYPAL_PROCUREMENT_CLIENT_ID=
PAYPAL_PROCUREMENT_CLIENT_SECRET=
PAYPAL_PROCUREMENT_WEBHOOK_ID=

# Render (API key for triggering Workflows from the API)
RENDER_API_KEY=

CHANNEL3_API_KEY=
LLM_API_KEY=
