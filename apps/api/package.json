{
  "name": "@quartermaster/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "day1:invoicing": "tsx --env-file-if-exists=../../.env scripts/day1/invoicing.ts",
    "day1:payouts": "tsx --env-file-if-exists=../../.env scripts/day1/payouts.ts",
    "day1:search": "tsx --env-file-if-exists=../../.env scripts/day1/search.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@quartermaster/shared": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
